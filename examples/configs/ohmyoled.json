{
  "matrix_options": {
    "chain_length": 1,
    "parallel": 1,
    "brightness": 50,
    "oled_slowdown": 3,
    "fail_on_error": false,
    "hardware_mapping": "adafruit-hat"
  },
  "time": {
    "run": true,
    "color": [255, 255, 255],
    "time_format": "12h",
    "timezone": "America/New_York"
  },
  "weather": [
    {
      "run": true,
      "api": "openweather",
      "api_key": "YOUR_OPENWEATHER_KEY",
      "current_location": true,
      "current_location_api_key": "YOUR_IPINFO_TOKEN",
      "weather_format": "imperial",
      "animation": "subtle"
    }
  ],
  "stock": [
    { "run": true, "api": "finnhub",   "api_key": "YOUR_FINNHUB_KEY", "symbol": "AAPL", "chart": true, "cache_ttl_secs": 0 },
    { "run": true, "api": "finnhub",   "api_key": "YOUR_FINNHUB_KEY", "symbol": "MSFT" },
    { "run": true, "api": "coingecko", "api_key": null,               "symbol": "bitcoin" },
    { "run": true, "api": "coingecko", "api_key": null,               "symbol": "ethereum" }
  ],
  "iss": {
    "run": true,
    "lat": 40.7128,
    "lon": -74.0060,
    "cache_ttl_secs": 30
  },
  "quake": {
    "run": true,
    "feed": "significant_day"
  },
  "aurora": {
    "run": true,
    "alert_threshold": 5
  },
  "flights": {
    "run": true,
    "lat": 40.7128,
    "lon": -74.0060,
    "radius_km": 80
  },
  "launch": {
    "run": true,
    "agency_filter": []
  },
  "pihole": {
    "run": true,
    "base_url": "http://pi.hole",
    "token": null
  },
  "hass": [
    {
      "run": true,
      "base_url": "http://homeassistant.local:8123",
      "token": "YOUR_HASS_LONG_LIVED_TOKEN",
      "entity_id": "sensor.kitchen_temp",
      "label": "KITCHEN"
    },
    {
      "run": true,
      "base_url": "http://homeassistant.local:8123",
      "token": "YOUR_HASS_LONG_LIVED_TOKEN",
      "entity_id": "binary_sensor.garage_door",
      "label": "GARAGE",
      "alarm_state": "open"
    }
  ],
  "sport": [
    {
      "run": true,
      "sport": "basketball",
      "team_logo": {
        "name": "Boston Celtics",
        "sportsdb_leagueid": 4387,
        "url": "https://www.thesportsdb.com/images/media/team/badge/...png",
        "sport": "basketball",
        "shorthand": "BOS",
        "apisportsid": 133,
        "sportsdbid": 134860,
        "sportsipyid": 0
      }
    },
    {
      "run": true,
      "sport": "hockey",
      "team_logo": {
        "name": "Boston Bruins",
        "sportsdb_leagueid": 4380,
        "url": "https://www.thesportsdb.com/images/media/team/badge/...png",
        "sport": "hockey",
        "shorthand": "BOS",
        "apisportsid": 673,
        "sportsdbid": 134830,
        "sportsipyid": 0
      }
    },
    { "run": true, "sport": "golf", "tour": "pga" },
    { "run": true, "sport": "f1" }
  ],
  "eink": {
    "enabled": false,
    "model": "7in5_v2",
    "rotation": 0,
    "threshold": 128,
    "modules": {
      "time": {
        "run": true,
        "color": [255, 255, 255],
        "time_format": "12h"
      },
      "weather": {
        "run": true,
        "api": "nws",
        "current_location": true,
        "weather_format": "imperial"
      }
    }
  }
}
